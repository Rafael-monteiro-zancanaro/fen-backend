# Spring profile required by Render production deployments.
SPRING_PROFILES_ACTIVE=prod

# Neon PostgreSQL JDBC connection. Keep sslmode=require if Neon supplies it.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Use a random value with at least 32 UTF-8 bytes.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=28800

# Comma-separated frontend origins. Do not use * with credentials.
FEN_CORS_ALLOWED_ORIGINS=http://localhost:4200

# A Render container filesystem is ephemeral unless a Persistent Disk is configured.
FEN_ATTACHMENTS_STORAGE_PATH=
